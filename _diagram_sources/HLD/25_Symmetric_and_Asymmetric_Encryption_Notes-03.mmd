graph TD
  K["128-bit key"] --> KE["Key expansion: 44 words = 11 round keys"]
  PT["128-bit plain-text block"] --> ARK0["Add round key (W0 - W3)"]
  KE --> ARK0
  ARK0 --> R1["Round 1: SubBytes, ShiftRows, MixColumns, AddRoundKey"]
